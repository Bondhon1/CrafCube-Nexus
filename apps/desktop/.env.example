# Supabase project credentials — copy to .env and fill in.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Object storage backend: "supabase" (default) or "b2".
# b2 additionally requires the storage-sign edge function to be deployed with
# its B2 secrets set — see docs/storage-backend.md.
VITE_STORAGE_BACKEND=supabase
